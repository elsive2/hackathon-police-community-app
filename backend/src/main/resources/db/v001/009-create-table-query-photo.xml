<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
    <changeSet id="create-query-photos-table" author="your_name">
        <createTable tableName="query_photo">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="query_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_query_photo_query"
                             referencedTableName="query" referencedColumnNames="id"/>
            </column>
            <column name="photo_url" type="varchar(512)">
                <constraints nullable="false"/>
            </column>

            <!-- Поля из BaseEntity -->
            <column name="is_deleted" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="create_date" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="change_date" type="timestamp">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>